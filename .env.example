APP_NAME="Tyche — Digital Marketing Academy"
APP_ENV=development
APP_DEBUG=true
APP_URL="http://localhost/tyche"
APP_TIMEZONE="Asia/Kolkata"

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tyche_db
DB_USER=root
DB_PASS=""
DB_CHARSET=utf8mb4

SESSION_LIFETIME=1800
SESSION_SECURE=false

MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=""
MAIL_PASS=""
MAIL_FROM_ADDRESS="no-reply@tyche.academy"
MAIL_FROM_NAME="Tyche Academy"

# Enterprise Cloud Object Storage & CDN Configuration (AWS S3, Cloudflare R2, DO Spaces, MinIO)
STORAGE_DRIVER=local # Options: local | s3
S3_KEY=""
S3_SECRET=""
S3_REGION="us-east-1"
S3_BUCKET="tyche-academy-media"
S3_ENDPOINT="" # Optional custom endpoint for Cloudflare R2 or DigitalOcean Spaces
CDN_URL="" # Optional asset CDN URL (e.g. https://cdn.tyche.academy)

